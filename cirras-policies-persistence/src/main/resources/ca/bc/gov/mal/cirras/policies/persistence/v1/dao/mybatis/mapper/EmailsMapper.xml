<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ca.bc.gov.mal.cirras.policies.persistence.v1.dao.mybatis.mapper.EmailsMapper">

	<resultMap id="emailsDtoMap" type="ca.bc.gov.mal.cirras.policies.persistence.v1.dto.EmailsDto">
		<id property="emailsId" column="emails_id" javaType="java.lang.Integer" jdbcType="NUMERIC" />

		<result property="contactsId" column="contacts_id" javaType="java.lang.Integer" jdbcType="NUMERIC" />
		<result property="emailAddress" column="address" javaType="java.lang.String" jdbcType="VARCHAR" />
		<result property="isPrimaryEmailInd" column="primary_email_flag" javaType="java.lang.Boolean" jdbcType="VARCHAR" />
		<result property="isActive" column="active_flag" javaType="java.lang.Boolean" jdbcType="VARCHAR" />
	</resultMap>
	
	<select id="select" statementType="CALLABLE" parameterType="java.util.Map">  
	  {
        call cirr_pkg_policies_api_v1.get_emails(
            #{dataCursor, jdbcType=CURSOR, resultMap=emailsDtoMap, mode=OUT},
            #{emailsId, javaType=java.lang.Integer, jdbcType=NUMERIC, mode=IN}
        )
      }
	</select>
	
</mapper>
