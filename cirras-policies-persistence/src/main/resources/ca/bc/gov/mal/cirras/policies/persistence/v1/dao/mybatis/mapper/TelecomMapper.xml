<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ca.bc.gov.mal.cirras.policies.persistence.v1.dao.mybatis.mapper.TelecomMapper">

	<resultMap id="telecomDtoMap" type="ca.bc.gov.mal.cirras.policies.persistence.v1.dto.TelecomDto">

		<id property="telecomId" column="telecom_id" javaType="java.lang.Integer" jdbcType="NUMERIC" />

		<result property="contactsId" column="contacts_id" javaType="java.lang.Integer" jdbcType="NUMERIC" />
		<result property="phoneNumber" column="phone_number" javaType="java.lang.String" jdbcType="VARCHAR" />
		<result property="extension" column="extension" javaType="java.lang.String" jdbcType="VARCHAR" />
		<result property="isPrimaryPhoneInd" column="primary_telecommunication_flag" javaType="java.lang.Boolean" jdbcType="VARCHAR" />
		<result property="telecomTypeCode" column="telecom_type_code" javaType="java.lang.String" jdbcType="VARCHAR" />
		<result property="isActive" column="active_flag" javaType="java.lang.Boolean" jdbcType="VARCHAR" />

	</resultMap>
	
	<select id="select" statementType="CALLABLE" parameterType="java.util.Map">  
	  {
        call cirr_pkg_policies_api_v1.get_telecommunications(
            #{dataCursor, jdbcType=CURSOR, resultMap=telecomDtoMap, mode=OUT},
            #{telecomId, javaType=java.lang.Integer, jdbcType=NUMERIC, mode=IN}
        )
      }
	</select>
	
</mapper>
