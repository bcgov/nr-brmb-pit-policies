<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ca.bc.gov.mal.cirras.policies.persistence.v1.dao.mybatis.mapper.UserMapper">

	<resultMap id="userDtoMap" type="ca.bc.gov.mal.cirras.policies.persistence.v1.dto.UserDto">
		<id property="usrId" column="USR_ID" javaType="java.lang.Integer" jdbcType="NUMERIC" />
		
		<result property="userid" column="USERID" javaType="java.lang.String" jdbcType="VARCHAR" />

	</resultMap>
	

	<select id="select" statementType="CALLABLE" parameterType="java.util.Map">  
	  {
        call cirr_pkg_policies_api_v1.get_user_by_account (
                #{dataCursor, jdbcType=CURSOR, resultMap=userDtoMap, mode=OUT},
                #{loginUserId, javaType=java.lang.String, jdbcType=VARCHAR, mode=IN}
			  ) 
      }
	</select> 
	
	
</mapper>
